# Copy values into Railway Variables. Replace each REPLACE_WITH value with a private value.
# Do not deploy this template unchanged. No real secrets belong in Git.
NODE_ENV=production
PORT=3000
APP_DATA_DIR=/data/app
TRUST_PROXY=railway
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=120
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
SHUTDOWN_TIMEOUT_SECONDS=110
PUBLIC_BASE_URL=https://app.offtheclockai.com
CLIENT_URL=https://app.offtheclockai.com
CORS_ALLOWED_ORIGINS=https://app.offtheclockai.com
JWT_SECRET=REPLACE_WITH_RANDOM_JWT
BOOKING_SLOT_TOKEN_SECRET=REPLACE_WITH_RANDOM_BOOKING
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_32_RANDOM_BYTES
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
BCRYPT_COST=12
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=30
OUTBOUND_WEBHOOKS_ENABLED=true

# Infrastructure validation first. Enable provider/billing/demo writes only with existing
# owner-approved credentials and after their configuration checks below are complete.
ALLOW_PROVIDER_WRITES=false
VOICE_RUNTIME_ENABLED=false
STRIPE_BILLING_ENABLED=false
DEMO_ENABLED=false
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=console
LOCAL_PREVIEW_MODE=false

# Railway automatically supplies RAILWAY_ENVIRONMENT_ID, RAILWAY_GIT_COMMIT_SHA and
# RAILWAY_VOLUME_MOUNT_PATH=/data after the volume is attached.
# Do not set DATABASE_PATH, PRICEBOOK_PATH, TEMP, TMP, TMPDIR or DEMO_TRUSTED_PROXY_HOPS.

# Optional Google Calendar: all three together, using this exact registered callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=https://app.offtheclockai.com/api/onboarding/calendar/google/callback

# Existing provider provisioning: required together when ALLOW_PROVIDER_WRITES=true.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# CARRIER_CONNECTION_URL=
# CARRIER_CONNECTION_TOKEN=

# Existing Stripe billing: all of these required when STRIPE_BILLING_ENABLED=true.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_OPERATOR_MONTHLY_PRICE_ID=price_...
# STRIPE_OPERATOR_ANNUAL_PRICE_ID=price_...
# STRIPE_QUOTEDONE_MONTHLY_PRICE_ID=price_...
# STRIPE_QUOTEDONE_ANNUAL_PRICE_ID=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://app.offtheclockai.com/onboarding?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=https://app.offtheclockai.com/onboarding?checkout=cancel
# STRIPE_PORTAL_RETURN_URL=https://app.offtheclockai.com/settings
# STRIPE_INTEGRATION_IDENTIFIER=offtheclock_AbCdEfGh

# Existing website demo: required key and origins when DEMO_ENABLED=true.
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# DEMO_ALLOWED_ORIGINS=https://offtheclockai.com,https://www.offtheclockai.com
# DEMO_IP_SALT=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
# DEMO_SESSIONS_PER_IP_PER_HOUR=2
# DEMO_DAILY_SESSION_CAP=200
# DEMO_MAX_CONCURRENT=10
# DEMO_SESSION_SECONDS=180
# DEMO_MILES_VOICE=Charon
# DEMO_NOVA_VOICE=Kore

# Voice lane only after its own integration and shutdown checks pass:
# TWILIO_AUTH_TOKEN=
# GEMINI_MODEL=
# VOICE_HANDLE_SECRET=

# Optional admin bootstrap: both together; bcrypt hash cost 10..16, never plaintext.
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# Live email remains deferred. Future email lane, not required for this deployment:
# EMAIL_FROM=
# RESEND_API_KEY=

# Required independent off-site daily backup destination (private, HTTPS).
OFFSITE_BACKUP_ENDPOINT=
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=
OFFSITE_BACKUP_ENCRYPTION_KEY=
# Must be unique to this production environment; do not share with staging.
OFFSITE_BACKUP_PREFIX=off-the-clock/production
OFFSITE_BACKUP_REGION=us-east-1
OFFSITE_BACKUP_SESSION_TOKEN=
