# Reference only. No credentials are supplied or enabled by this file.
# Do not change provider configuration or run paid sessions without approval.
DEMO_ENABLED=false
DEMO_PORT=8787
DEMO_ORIGIN=http://127.0.0.1:8787
DEMO_BIND_HOST=127.0.0.1
# Existing server-side Gemini key. Never put this in a browser or repository.
GEMINI_API_KEY=
# Explicitly select the approved Live model; there is no silent model upgrade.
GEMINI_LIVE_MODEL=
DEMO_MILES_NAME=Miles
DEMO_MILES_VOICE=Puck
DEMO_NOVA_NAME=Nova
DEMO_NOVA_VOICE=Kore
DEMO_MAX_CONCURRENT=10
# All three values are required before enabling. See README accounting limits.
DEMO_DAILY_BUDGET_USD=
DEMO_SESSION_RESERVE_USD=
DEMO_MAX_TOKEN_RATE_USD_PER_MILLION=
# Set only after choosing the actual trial destination. No fake signup link.
DEMO_SIGNUP_URL=
# Comma-separated exact trusted proxy IPs, only after deployment topology review.
DEMO_TRUST_PROXY_IPS=
