DATABASE_PATH=./data/off-the-clock.sqlite
PRICEBOOK_PATH=./data/pricebooks
JWT_SECRET=
BCRYPT_COST=12
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@offtheclockai.com
# Production: EMAIL_PROVIDER=resend, verified EMAIL_FROM, and HTTPS CLIENT_URL.
# Enable only after the sender and production delivery checks are accepted.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=

# Twilio account routing and REST API authentication.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Inbound X-Twilio-Signature validation only; never use for REST requests.
TWILIO_AUTH_TOKEN=

PUBLIC_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOW_PROVIDER_WRITES=false
VOICE_RUNTIME_ENABLED=false
# Admission limits share the production SQLite database. All are positive integers.
VOICE_MAX_CONCURRENT=100
VOICE_MAX_CONCURRENT_PER_OWNER=5
VOICE_CALLER_DAILY_LIMIT=6
VOICE_BREAKER_FAILURE_THRESHOLD=3
VOICE_BREAKER_WINDOW_SECONDS=60
VOICE_BREAKER_COOLDOWN_SECONDS=30
# HTTPS outbound webhooks are independent of voice/phone provider writes.
# Production defaults to enabled if unset; explicit false pauses dispatch.
OUTBOUND_WEBHOOKS_ENABLED=false

CARRIER_CONNECTION_URL=
CARRIER_CONNECTION_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
# Explicit text generation model for knowledge and price-book drafts; no default.
GEMINI_TEXT_MODEL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/onboarding/calendar/google/callback
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
BOOKING_SLOT_TOKEN_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_ENABLED=false
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_OPERATOR_MONTHLY_PRICE_ID=
STRIPE_OPERATOR_ANNUAL_PRICE_ID=
STRIPE_QUOTEDONE_MONTHLY_PRICE_ID=
STRIPE_QUOTEDONE_ANNUAL_PRICE_ID=
STRIPE_SCALE_MONTHLY_PRICE_ID=
STRIPE_SCALE_ANNUAL_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/settings/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/settings/billing?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/settings/billing
# Stable label with an eight-random-letter suffix for Stripe Dashboard tracking.
STRIPE_INTEGRATION_IDENTIFIER=offtheclock_abcdefgh
DEMO_DAILY_BUDGET_USD=25
DEMO_CONCURRENT_MAX=10
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Off-site backups: separate private bucket/prefix for each environment.
# Production warns and admin status reports unhealthy until all five are set.
OFFSITE_BACKUP_ENDPOINT=
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=
# Independent 32-byte random encryption key, canonical base64 or 64 hex chars.
OFFSITE_BACKUP_ENCRYPTION_KEY=
OFFSITE_BACKUP_PREFIX=off-the-clock
OFFSITE_BACKUP_REGION=us-east-1
# Optional when using temporary S3 credentials.
OFFSITE_BACKUP_SESSION_TOKEN=
